# Sentinelas backend — environment template
#
# Copy to backend/.env and adjust only if you need to override a default.
# Every value below is already the built-in default, so the backend runs
# with no .env file at all.
#
#   cp backend/.env.example backend/.env
#
# backend/.env is gitignored — never put real secrets in this file.

# ── n8n alert webhook ────────────────────────────────────────────────────────
# Anomalies confirmed by the ML pipeline are POSTed here; the workflow routes
# them to Telegram (and email, once an SMTP credential is attached).
#
# Default: the shared n8n Cloud instance — works for every teammate after a
# plain `git pull`, no local n8n required.
# Cloud workflow: https://nourzz.app.n8n.cloud/workflow/d1QiZbMLmR7fOJDA
N8N_WEBHOOK_URL=https://nourzz.app.n8n.cloud/webhook/sentinelas-anomaly

# To run your own n8n instead (e.g. the Docker container in n8n/README.md):
#N8N_WEBHOOK_URL=http://localhost:4555/webhook/sentinelas-anomaly

# ── Chat assistant (optional overrides) ──────────────────────────────────────
#OLLAMA_URL=http://localhost:11434
#OLLAMA_MODEL=llama3.2:3b
#OLLAMA_TIMEOUT_SECONDS=180
